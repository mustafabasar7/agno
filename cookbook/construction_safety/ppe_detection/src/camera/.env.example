# Environment variables for RTSP Camera System
# Copy this file to .env and update with your actual values

# Camera Configuration File Path (optional)
# If not set, will search in default locations
CAMERA_CONFIG_FILE=camera_config.yaml

# Snapshot Storage
SNAPSHOT_DIR=/var/ppe_detection/snapshots
SNAPSHOT_RETENTION_DAYS=7

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/ppe_detection/camera.log

# Health Monitoring
HEALTH_CHECK_INTERVAL=10.0

# Alternative: Define cameras via environment variables
# Format: CAMERA_<N>_<FIELD> where N is 1, 2, 3, etc.

# Camera 1 - Main Entrance
CAMERA_1_ID=cam_giris_001
CAMERA_1_URL=rtsp://admin:password@192.168.1.100:554/Streaming/Channels/101
CAMERA_1_NAME=Ana Giriş Kapısı
CAMERA_1_ZONE=Giriş Kontrol
CAMERA_1_LOCATION=Şantiye Ana Girişi
CAMERA_1_INTERVAL=5.0
CAMERA_1_ENABLED=true

# Camera 2 - Construction Area
CAMERA_2_ID=cam_insaat_001
CAMERA_2_URL=rtsp://admin:password@192.168.1.101:554/Streaming/Channels/101
CAMERA_2_NAME=İnşaat Alanı A
CAMERA_2_ZONE=İnşaat Bölgesi A
CAMERA_2_LOCATION=A Blok İnşaat Alanı
CAMERA_2_INTERVAL=5.0
CAMERA_2_ENABLED=true

# Camera 3 - Crane Area
CAMERA_3_ID=cam_vinc_001
CAMERA_3_URL=rtsp://admin:password@192.168.1.102:554/cam/realmonitor?channel=1&subtype=0
CAMERA_3_NAME=Vinç Alanı
CAMERA_3_ZONE=Vinç Operasyon
CAMERA_3_LOCATION=Kule Vinç 1
CAMERA_3_INTERVAL=5.0
CAMERA_3_ENABLED=true

# Add more cameras as needed...
# CAMERA_4_ID=...
# CAMERA_4_URL=...
# etc.

# Network Settings
RTSP_CONNECTION_TIMEOUT=10.0
RTSP_READ_TIMEOUT=5.0
RTSP_RECONNECT_INTERVAL=5.0
MAX_RECONNECT_ATTEMPTS=3

# Performance Settings
FRAME_BUFFER_SIZE=1
TARGET_FPS=30

# Optional: Resize frames to reduce bandwidth/CPU
# FRAME_WIDTH=1280
# FRAME_HEIGHT=720
