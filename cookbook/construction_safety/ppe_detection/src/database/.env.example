# Database Configuration for PPE Detection System
# Copy this file to .env and update with your settings

# ============================================================================
# Database Type
# ============================================================================
# Options: sqlite, postgresql
DB_TYPE=sqlite

# ============================================================================
# SQLite Configuration (Development)
# ============================================================================
# Path to SQLite database file
DB_PATH=./data/ppe_detection.db

# ============================================================================
# PostgreSQL Configuration (Production)
# ============================================================================
# Uncomment and configure these for PostgreSQL

# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_NAME=ppe_detection

# ============================================================================
# Alternative: Full Database URL
# ============================================================================
# You can use a full database URL instead of individual components
# This takes precedence over the individual settings above

# For SQLite:
# DATABASE_URL=sqlite:///./data/ppe_detection.db

# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/ppe_detection

# For async PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ppe_detection

# ============================================================================
# Database Connection Pooling (PostgreSQL only)
# ============================================================================
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=3600

# ============================================================================
# Logging
# ============================================================================
# Enable SQL query logging (set to true for debugging)
# DB_ECHO=false
