# PPE Detection Application - Environment Configuration
# Copy this file to .env and update with your actual values

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_ENV=production
APP_PORT=8000
LOG_LEVEL=info
DEBUG=false

# ==============================================================================
# SECURITY
# ==============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_change_this_in_production

# API Key for external access
API_KEY=your_api_key_here

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DB_NAME=ppe_detection
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_HOST=db
DB_PORT=5432

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ==============================================================================
# AGNO AI CONFIGURATION
# ==============================================================================
AGNO_API_KEY=your_agno_api_key_here
AGNO_MODEL=gpt-4o
AGNO_TEMPERATURE=0.7
AGNO_MAX_TOKENS=4096

# ==============================================================================
# PPE DETECTION SETTINGS
# ==============================================================================
# Detection confidence threshold (0.0 - 1.0)
DETECTION_CONFIDENCE_THRESHOLD=0.5

# Intersection over Union threshold for NMS (0.0 - 1.0)
DETECTION_IOU_THRESHOLD=0.45

# Model path (local or download from cloud)
MODEL_PATH=/app/data/models/ppe_detection.pt
MODEL_URL=https://your-model-storage.com/ppe_detection.pt

# Detection classes (comma-separated)
DETECTION_CLASSES=person,hardhat,safety_vest,no_hardhat,no_vest

# ==============================================================================
# CAMERA CONFIGURATION
# ==============================================================================
# Multiple camera URLs (comma-separated)
# Formats: rtsp://user:pass@ip:port/stream, http://ip/video.mjpg
CAMERA_URLS=rtsp://admin:password@192.168.1.100:554/stream1,rtsp://admin:password@192.168.1.101:554/stream1

# Camera settings
CAMERA_RECONNECT_DELAY=5
CAMERA_MAX_RETRIES=3
CAMERA_TIMEOUT=10

# Frame processing
FRAME_PROCESSING_INTERVAL=1
FRAME_SKIP_COUNT=0
FRAME_BUFFER_SIZE=10

# Video resolution
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30

# ==============================================================================
# MONITORING & ALERTS
# ==============================================================================
# Enable/disable monitoring
ENABLE_MONITORING=true
ENABLE_ALERTS=true

# Alert thresholds
ALERT_VIOLATION_COUNT_THRESHOLD=3
ALERT_COOLDOWN_SECONDS=300

# Email alerts (if configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
ALERT_EMAIL_FROM=alerts@ppe-detection.local
ALERT_EMAIL_TO=safety@company.com,manager@company.com

# Webhook alerts
ALERT_WEBHOOK_URL=https://your-webhook-url.com/alerts

# ==============================================================================
# NGINX CONFIGURATION
# ==============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ==============================================================================
# MONITORING TOOLS (Optional)
# ==============================================================================
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ==============================================================================
# DEVELOPMENT TOOLS (Development only)
# ==============================================================================
# PGAdmin
PGADMIN_EMAIL=admin@ppe.local
PGADMIN_PASSWORD=admin

# Flower (Celery monitoring)
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# ==============================================================================
# CELERY CONFIGURATION
# ==============================================================================
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_WORKER_CONCURRENCY=2

# ==============================================================================
# FILE STORAGE
# ==============================================================================
# Local storage paths
DATA_PATH=/app/data
VIDEO_STORAGE_PATH=/app/data/videos
IMAGE_STORAGE_PATH=/app/data/images
MODEL_STORAGE_PATH=/app/data/models

# Storage limits
MAX_VIDEO_SIZE_MB=1000
MAX_IMAGE_SIZE_MB=10
VIDEO_RETENTION_DAYS=7

# Cloud storage (optional - AWS S3, Azure Blob, GCP)
CLOUD_STORAGE_ENABLED=false
CLOUD_STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=ppe-detection-videos
AWS_REGION=us-east-1

# ==============================================================================
# PERFORMANCE TUNING
# ==============================================================================
# Worker settings
WORKERS_COUNT=2
WORKER_TIMEOUT=120

# Batch processing
BATCH_SIZE=8
MAX_BATCH_WAIT_TIME=5

# GPU settings (if available)
USE_GPU=false
GPU_DEVICE_ID=0

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_FORMAT=json
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10
LOG_ROTATION=daily

# ==============================================================================
# HEALTH CHECKS
# ==============================================================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_START_PERIOD=40

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==============================================================================
# CORS (Cross-Origin Resource Sharing)
# ==============================================================================
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE
CORS_ALLOW_HEADERS=*

# ==============================================================================
# CONSTRUCTION SITE SPECIFIC
# ==============================================================================
SITE_NAME=Construction Site Alpha
SITE_LOCATION=Building A, Zone 1
SITE_TIMEZONE=America/New_York
SHIFT_START_TIME=07:00
SHIFT_END_TIME=19:00

# ==============================================================================
# COMPLIANCE & REPORTING
# ==============================================================================
GENERATE_DAILY_REPORTS=true
REPORT_EMAIL_TO=safety@company.com
REPORT_GENERATION_TIME=18:00
COMPLIANCE_STANDARD=OSHA

# ==============================================================================
# BACKUP & MAINTENANCE
# ==============================================================================
AUTO_BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/data/backups
